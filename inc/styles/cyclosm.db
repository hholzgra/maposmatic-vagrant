#! /bin/bash -e

pushd . > /dev/null

DBNAME="${DBNAMES[classic]:-gis}"
CONTOURS="${DBNAMES[contours]:-contours}"

cd "$STYLEDIR"/cyclosm-cartocss-style

sed -e's/CASE WHEN layer/CASE WHEN layer::text/g' < views.sql | sudo -u maposmatic psql "$DBNAME"

# style expects contours table under a different name, and ele column with different type
sudo -u maposmatic psql "$CONTOURS" -c "CREATE OR REPLACE VIEW planet_osm_line AS SELECT gid, id, ele::int AS ele, way FROM contours;"

popd > /dev/null
